# Maigo Production Environment Configuration
# Copy this file to .env.production and update with your values

# Database Configuration
DB_NAME=maigo
DB_USER=maigo
DB_PASSWORD=your-secure-database-password-here
DB_PORT=5432

# Server Configuration
PORT=8080
HOST=0.0.0.0
APP_ENV=production
# Optional comma-separated proxy IPs/CIDRs. Keep empty for direct connections.
TRUSTED_PROXIES=

# OAuth 2.0 Configuration
# Legacy single-key compatibility mode. For a fresh key-ring deployment leave
# this empty; during migration retain the old value until no-kid tokens expire.
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters
JWT_EXPIRATION=24h
# Delete expired refresh-session rows hourly; set to 0 only with an explicit
# external cleanup policy.
SESSION_CLEANUP_INTERVAL=1h
OAUTH2_CLIENT_ID=maigo-cli
OAUTH2_CLIENT_SECRET=your-secure-client-secret-here

# Rotating HMAC key mode. Keep the previous key until all tokens signed with it
# have expired, then remove it from JWT_KEYS.
# JWT_ACTIVE_KEY_ID=primary-2026
# JWT_KEYS=primary-2026=<32-byte-secret>,primary-2025=<32-byte-secret>

# Application Configuration
GIN_MODE=release
LOG_LEVEL=info
LOG_FORMAT=json
BASE_DOMAIN=short.example.com
APP_TLS=true
DEBUG=false
CORS_ENABLED=false
# Required when CORS_ENABLED=true; use exact scheme + host + optional port.
CORS_ORIGINS=
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1h
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=15m

# Short Code Configuration
SHORT_CODE_LENGTH=6

# Optional distributed rate limiting. Enable this and start the Compose Redis
# profile before running multiple application replicas.
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PASSWORD=your-secure-redis-password
REDIS_PORT=6379
REDIS_DB=0
REDIS_FAIL_OPEN=false

# Click-event analytics retention (Go duration; 2160h is 90 days)
CLICK_EVENT_RETENTION=2160h
CLICK_EVENT_CLEANUP_INTERVAL=1h

# Security Notes:
# 1. Generate secure secrets: openssl rand -hex 32
# 2. Never commit .env.production to version control
# 3. Use strong passwords for all services
# 4. Change all default values in production
# 5. Enable SSL/TLS for database connections in production
