# Copy to .env.production and replace API_KEY and PUBLIC_URL.
API_KEY=replace-with-a-random-secret-at-least-32-bytes
PUBLIC_URL=https://short.example.com
APP_ENV=production
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=json

# The Compose file stores the database in its named maigo_data volume.
# PORT is the host port; the application listens on 8080 inside the container.
PORT=8080
