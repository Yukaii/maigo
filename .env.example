# Development environment variables
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maigo_dev
DB_USER=postgres
DB_PASSWORD=password
DB_SSL_MODE=disable

# Server configuration
HTTP_PORT=8080
HOST=127.0.0.1
APP_ENV=development
# Leave empty unless a known reverse-proxy network should be trusted.
TRUSTED_PROXIES=

# OAuth2 configuration
OAUTH2_CLIENT_ID=maigo-cli
OAUTH2_CLIENT_SECRET=cli-client-secret-not-used-with-pkce
OAUTH2_REDIRECT_URI=http://localhost:8000/callback

# JWT configuration
# Legacy single-key compatibility mode. Leave this empty for a fresh JWT_KEYS
# deployment; retain the old value during migration of no-kid tokens.
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRATION=24h
# Rotation mode: use comma-separated kid=secret entries and retain old keys
# until every token signed with them has expired.
# JWT_ACTIVE_KEY_ID=primary-2026
# JWT_KEYS=primary-2026=<32-byte-secret>,primary-2025=<32-byte-secret>

# Application configuration
BASE_DOMAIN=localhost:8080
APP_TLS=false
SHORT_CODE_LENGTH=6
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1h
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=15m

# Development settings
DEBUG=true
LOG_LEVEL=debug
CORS_ENABLED=true
# Optional comma-separated browser origins. Leave empty in local development
# to use the debug-only wildcard.
CORS_ORIGINS=

# Optional distributed rate limiting
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_FAIL_OPEN=false

# Click-event analytics retention (Go duration; 2160h is 90 days)
CLICK_EVENT_RETENTION=2160h
CLICK_EVENT_CLEANUP_INTERVAL=1h
