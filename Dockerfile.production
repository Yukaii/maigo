# Production image for Maigo Core. SQLite is pure Go, so the binary is built
# without CGO and the runtime image only needs certificates, timezone data,
# and a health-check client.
FROM golang:1.25-alpine AS builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64

RUN apk add --no-cache git
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath -ldflags="-w -s" -o maigo ./cmd/maigo

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata wget \
    && addgroup -S maigo \
    && adduser -S -G maigo maigo \
    && mkdir -p /data \
    && chown -R maigo:maigo /data

WORKDIR /app
COPY --from=builder /build/maigo /usr/local/bin/maigo
COPY --from=builder /build/maigo.example.yaml ./maigo.example.yaml

USER maigo
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/maigo"]
CMD ["server"]
